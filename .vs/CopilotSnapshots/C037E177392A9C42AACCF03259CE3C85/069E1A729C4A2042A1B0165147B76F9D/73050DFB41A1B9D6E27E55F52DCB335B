import React, { useEffect } from "react";
import { BrowserRouter, Navigate, Route, Routes, useLocation } from "react-router-dom";
import Layout from "@/layout/Index";
import LayoutNoSidebar from "@/layout/Index-nosidebar";
import ThemeProvider from "@/layout/provider/Theme";
import { AuthGuard, GuestGuard } from "@/components/guards";
import Login from "@/pages/auth/Login";
import Register from "@/pages/auth/Register";
import ForgotPassword from "@/pages/auth/ForgotPassword";
import ResetPassword from "@/pages/auth/ResetPassword";
import ConfirmEmail from "@/pages/auth/ConfirmEmail";
import Success from "@/pages/auth/Success";
import PmProductsPage from "@/pages/pm/PmProductsPage";
import PmAttributesPage from "@/pages/pm/PmAttributesPage";
import PmCategoriesPage from "@/pages/pm/PmCategoriesPage";
import PmSuppliersPage from "@/pages/pm/PmSuppliersPage";
import PmWarehousesPage from "@/pages/pm/PmWarehousesPage";
import PmVariantsPage from "@/pages/pm/PmVariantsPage";
import PmPricesPage from "@/pages/pm/PmPricesPage";
import PmProfilesPage from "@/pages/pm/PmProfilesPage";
import PmRelationsPage from "@/pages/pm/PmRelationsPage";
import PmInventoriesPage from "@/pages/pm/PmInventoriesPage";
import PmTransactionsPage from "@/pages/pm/PmTransactionsPage";
import PmReservationsPage from "@/pages/pm/PmReservationsPage";
import PmPriceListsPage from "@/pages/pm/PmPriceListsPage";
import PmPriceListItemsPage from "@/pages/pm/PmPriceListItemsPage";

const ScrollToTop = ({ children }: { children: React.ReactNode }) => {
  const location = useLocation();

  useEffect(() => {
    window.scrollTo(0, 0);
  }, [location.pathname]);

  return <>{children}</>;
};

const Pages = () => {
  return (
    <BrowserRouter future={{ v7_startTransition: true, v7_relativeSplatPath: true }}>
      <ScrollToTop>
        <Routes>
          <Route element={<ThemeProvider />}>
            <Route element={<AuthGuard />}>
              <Route element={<Layout />}>
                <Route index element={<Navigate to="/pm-products" replace />} />
                <Route path="pm-products" element={<PmProductsPage />} />
                <Route path="pm-attributes" element={<PmAttributesPage />} />
                <Route path="pm-catalog/categories" element={<PmCategoriesPage />} />
                <Route path="pm-catalog/suppliers" element={<PmSuppliersPage />} />
                <Route path="pm-catalog/warehouses" element={<PmWarehousesPage />} />
                <Route path="pm-commerce/variants" element={<PmVariantsPage />} />
                <Route path="pm-commerce/prices" element={<PmPricesPage />} />
                <Route path="pm-profiles" element={<PmProfilesPage />} />
                <Route path="pm-relations" element={<PmRelationsPage />} />
                <Route path="pm-inventory/inventories" element={<PmInventoriesPage />} />
                <Route path="pm-inventory/transactions" element={<PmTransactionsPage />} />
                <Route path="pm-inventory/reservations" element={<PmReservationsPage />} />
                <Route path="pm-pricelists" element={<PmPriceListsPage />} />
                <Route path="pm-pricelists/items" element={<PmPriceListItemsPage />} />
              </Route>
            </Route>

            <Route element={<LayoutNoSidebar />}>
              <Route element={<GuestGuard />}>
                <Route path="auth-success" element={<Success />} />
                <Route path="auth-reset" element={<ForgotPassword />} />
                <Route path="auth-register" element={<Register />} />
                <Route path="auth-login" element={<Login />} />
                <Route path="login" element={<Login />} />
                <Route path="register" element={<Register />} />
                <Route path="forgot-password" element={<ForgotPassword />} />
                <Route path="reset-password" element={<ResetPassword />} />
                <Route path="confirm-email" element={<ConfirmEmail />} />
              </Route>
              <Route path="*" element={<Navigate to="/pm-products" replace />} />
            </Route>
          </Route>
        </Routes>
      </ScrollToTop>
    </BrowserRouter>
  );
};

export default Pages;
